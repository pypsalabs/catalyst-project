# Snakemake workflow: weather-year datasets for the one-node toy models (misc-quarter1/weather-years).
#
#   extract_bus_profiles  2013 bus profiles of the hand-picked sites from the PyPSA-Earth stage networks
#                                                            -> build/profiles_sites.nc, build/sites.csv
#   siteyears             the sites x ERA5 weather years 2014-2023 (Open-Meteo, 3 x 3 cell stencil per site,
#                         calibrated to the 2013 bus profiles)  -> build/profiles_siteyears.nc (100 series)
#                                                            + figures/siteyears_validation.{png,pdf}
#   years                 one place (Northern Germany) x 2014-2023 -> build/profiles_years.nc
#   sites_map             where the weather data is            -> figures/sites_map.{png,pdf}
#
# Inputs: ../../models/pypsa-earth/networks/<run>/elec_s_*.nc (stage networks, 2013), the Open-Meteo archive
# API (cached in data/openmeteo/, free tier: 10,000 call weights per day, 13 per point-year; a "Daily" limit
# stops the run, rerun the next day). Run from misc-quarter1/weather-years with the priam-myopic pixi env,
# ALWAYS with --rerun-triggers mtime: with the default triggers an edit of retrieve_weather.py (code) or of the
# stencil params marks every cached point-year as outdated, snakemake deletes the file and refetches it (that
# burnt a quarter of a day's quota on 2026-10-07):
#   ../../models/priam-myopic/.pixi/envs/default/bin/snakemake -c1 --rerun-triggers mtime

configfile: "config.yaml"

FORMATS = config["plotting"]["formats"]
RUNS = {r: f"{config['networks_dir']}/{f}" for r, f in config["runs"].items()}
Y = config["years"]
YEARS = list(range(Y["first"], Y["last"] + 1))
SITE = Y["site"]
SY = config["siteyears"]
SY_YEARS = list(range(min(SY["first"], SY["calibration_year"]), SY["last"] + 1))   # calibration year included

wildcard_constraints:
    year=r"\d{4}",
    lat=r"-?\d+\.\d\d",
    lon=r"-?\d+\.\d\d",


rule all:
    input:
        "build/profiles_siteyears.nc",
        "build/profiles_years.nc",
        expand("figures/siteyears_validation.{fmt}", fmt=FORMATS),
        expand("figures/sites_map.{fmt}", fmt=FORMATS),


rule extract_bus_profiles:
    input:
        networks=sorted({RUNS[s["run"]] for s in config["sites"].values()}),
        config="config.yaml",
    output:
        profiles="build/profiles_sites.nc",
        sites="build/sites.csv",
    resources:
        mem_mb=6000, runtime="10m",
    script:
        "extract_bus_profiles.py"


# ---------------------------------------------------------------- the sites x weather years
checkpoint sample_points:
    input:
        sites="build/sites.csv",
        config="config.yaml",
    output:
        "build/siteyears_points.csv",
    resources:
        mem_mb=500, runtime="1m",
    script:
        "sample_points.py"


rule retrieve_point_weather:
    output:
        "data/openmeteo/pt_{lat}_{lon}_{year}.csv",
    params:
        lat=lambda w: float(w.lat), lon=lambda w: float(w.lon), cell_selection=SY["cell_selection"],
    resources:
        mem_mb=500, runtime="10m", openmeteo=1,     # serial downloads (free-tier quota; -c1 or --resources openmeteo=1)
    script:
        "retrieve_weather.py"


def point_weather(wildcards):
    import pandas as pd
    pts = pd.read_csv(checkpoints.sample_points.get().output[0])
    cells = pts[["lat", "lon"]].drop_duplicates()
    return [f"data/openmeteo/pt_{lat:.2f}_{lon:.2f}_{year}.csv" for lat, lon in cells.itertuples(index=False) for year in SY_YEARS]


rule build_siteyears:
    input:
        weather=point_weather,
        points="build/siteyears_points.csv",
        sites="build/sites.csv",
        profiles="build/profiles_sites.nc",
        config="config.yaml",
    output:
        profiles="build/profiles_siteyears.nc",
        table="build/siteyears.csv",
        calibration="build/siteyears_calibration.csv",
        validation="build/siteyears_2013.nc",
    resources:
        mem_mb=3000, runtime="10m",
    script:
        "build_siteyears.py"


rule plot_siteyears_validation:
    input:
        validation="build/siteyears_2013.nc",
        calibration="build/siteyears_calibration.csv",
        config="config.yaml",
    output:
        expand("figures/siteyears_validation.{fmt}", fmt=FORMATS),
    resources:
        mem_mb=1500, runtime="5m",
    script:
        "plot_siteyears_validation.py"


# ---------------------------------------------------------------- one place x weather years
rule retrieve_weather:
    output:
        f"data/openmeteo/{SITE['key']}_{{year}}.csv",
    params:
        lat=SITE["lat"], lon=SITE["lon"],
    resources:
        mem_mb=500, runtime="10m", openmeteo=1,
    script:
        "retrieve_weather.py"


rule build_years:
    input:
        weather=expand(f"data/openmeteo/{SITE['key']}_{{year}}.csv", year=YEARS),
        network=RUNS[SITE["run"]],
        config="config.yaml",
    output:
        profiles="build/profiles_years.nc",
        years="build/years.csv",
        correlation="build/years_correlation.csv",
    resources:
        mem_mb=2000, runtime="5m",
    script:
        "build_years.py"


# ---------------------------------------------------------------- map
rule plot_sites_map:
    input:
        sites="build/sites.csv",
        points="build/siteyears_points.csv",
        config="config.yaml",
    output:
        expand("figures/sites_map.{fmt}", fmt=FORMATS),
    resources:
        mem_mb=1500, runtime="5m",
    script:
        "plot_sites_map.py"
