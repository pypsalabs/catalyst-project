# Snakemake workflow: temporal structure of the residual demand when wind or solar alone is
# scaled to meet it (misc-quarter1/fourier, exploratory, WP3 preparation). Two variants of the
# same six-row figure:
#
#   years  one site, ten ERA5 weather years (Open-Meteo archive, cached in data/openmeteo/)
#          + the site's PyPSA-Earth demand profile           -> figures/residual_structure_years.{png,pdf}
#   sites  ten mutually uncorrelated PyPSA-Earth buses, 2013 -> figures/residual_structure_sites.{png,pdf}
#          + figures/site_correlation.{png,pdf}                  (independence check)
#   siteyears  the ten sites x ten ERA5 weather years 2014-2023 (Open-Meteo, 3 x 3 cell stencil per site,
#          calibrated to the 2013 bus profiles)                 -> build/profiles_siteyears.nc (100 series)
#          + figures/siteyears_validation.{png,pdf}              (2013: bus vs point-average, raw and calibrated)
# Each variant also gets figures/residual_bands_<variant>.{png,pdf}: the residual variability binned
# into intra-day / multi-day / seasonal as a radar chart (numbers in build/bands_<variant>.csv), and
# figures/residual_bands_mix.{png,pdf} puts the pure triangles next to two country mixes (GB wind-heavy,
# India solar-heavy) built from country-aggregated PyPSA-Earth profiles.
#
# Inputs: ../../models/pypsa-earth/networks/{US,NWE,BR,IN}/elec_s_50.nc (stage networks, 2013).
# Run from misc-quarter1/fourier with the priam-myopic pixi env:
#   ../../models/priam-myopic/.pixi/envs/default/bin/snakemake -c1

configfile: "config.yaml"

FORMATS = config["plotting"]["formats"]
NETWORKS = {r: f"{config['networks_dir']}/{spec['file']}" for r, spec in config["regions"].items()}
Y = config["years"]
YEARS = list(range(Y["first"], Y["last"] + 1))
SITE = Y["site"]
SY = config["siteyears"]
SY_YEARS = list(range(min(SY["first"], SY["calibration_year"]), SY["last"] + 1))   # calibration year included

wildcard_constraints:
    variant="sites|years",
    year=r"\d{4}",
    lat=r"-?\d+\.\d\d",
    lon=r"-?\d+\.\d\d",


rule all:
    input:
        expand("figures/residual_{fig}_{variant}.{fmt}", fig=["structure", "bands"], variant=["years", "sites"], fmt=FORMATS),
        expand("figures/site_correlation.{fmt}", fmt=FORMATS),
        expand("figures/residual_bands_mix.{fmt}", fmt=FORMATS),
        expand("figures/siteyears_validation.{fmt}", fmt=FORMATS),


rule retrieve_weather:
    output:
        f"data/openmeteo/{SITE['key']}_{{year}}.csv",
    params:
        lat=SITE["lat"], lon=SITE["lon"],
    resources:
        mem_mb=500, runtime="10m",
    script:
        "retrieve_weather.py"


rule build_years:
    input:
        weather=expand(f"data/openmeteo/{SITE['key']}_{{year}}.csv", year=YEARS),
        network=NETWORKS[SITE["region"]],
        config="config.yaml",
    output:
        profiles="build/profiles_years.nc",
        years="build/years.csv",
        correlation="build/years_correlation.csv",
    resources:
        mem_mb=2000, runtime="5m",
    script:
        "build_years.py"


rule extract_sites:
    input:
        networks=list(NETWORKS.values()),
        config="config.yaml",
    output:
        profiles="build/profiles_sites.nc",
        sites="build/sites.csv",
        correlation="build/site_correlation.csv",
    resources:
        mem_mb=4000, runtime="10m",
    script:
        "extract_profiles.py"


rule plot_correlation:
    input:
        sites="build/sites.csv",
        correlation="build/site_correlation.csv",
        config="config.yaml",
    output:
        expand("figures/site_correlation.{fmt}", fmt=FORMATS),
    resources:
        mem_mb=1000, runtime="5m",
    script:
        "plot_site_correlation.py"


rule plot_residual:
    input:
        profiles="build/profiles_{variant}.nc",
        mix=lambda w: "build/bands_mix.csv" if w.variant == "years" else [],   # row h of the years figure
        config="config.yaml",
    output:
        structure=expand("figures/residual_structure_{{variant}}.{fmt}", fmt=FORMATS),
        bands=expand("figures/residual_bands_{{variant}}.{fmt}", fmt=FORMATS),
        table="build/bands_{variant}.csv",
    resources:
        mem_mb=2000, runtime="5m",
    script:
        "plot_residual_structure.py"


MIX_REGIONS = sorted({spec["region"] for spec in config["mixes"].values()})


rule plot_mix:
    input:
        pure="build/profiles_years.nc",
        networks=[NETWORKS[r] for r in MIX_REGIONS],
        config="config.yaml",
    params:
        regions=MIX_REGIONS,
    output:
        figure=expand("figures/residual_bands_mix.{fmt}", fmt=FORMATS),
        table="build/bands_mix.csv",
    resources:
        mem_mb=4000, runtime="10m",
    script:
        "plot_mix_radar.py"


# ---------------------------------------------------------------- ten sites x ten weather years
checkpoint sample_points:
    input:
        sites="build/sites.csv",
        config="config.yaml",
    output:
        "build/siteyears_points.csv",
    resources:
        mem_mb=500, runtime="1m",
    script:
        "sample_points.py"


rule retrieve_point_weather:
    output:
        "data/openmeteo/pt_{lat}_{lon}_{year}.csv",
    params:
        lat=lambda w: float(w.lat), lon=lambda w: float(w.lon), cell_selection=SY["cell_selection"],
    resources:
        mem_mb=500, runtime="10m", openmeteo=1,     # serial downloads (free-tier quota; -c1 or --resources openmeteo=1)
    script:
        "retrieve_weather.py"


def point_weather(wildcards):
    import pandas as pd
    pts = pd.read_csv(checkpoints.sample_points.get().output[0])
    cells = pts[["lat", "lon"]].drop_duplicates()
    return [f"data/openmeteo/pt_{lat:.2f}_{lon:.2f}_{year}.csv" for lat, lon in cells.itertuples(index=False) for year in SY_YEARS]


rule build_siteyears:
    input:
        weather=point_weather,
        points="build/siteyears_points.csv",
        sites="build/sites.csv",
        profiles="build/profiles_sites.nc",
        config="config.yaml",
    output:
        profiles="build/profiles_siteyears.nc",
        table="build/siteyears.csv",
        calibration="build/siteyears_calibration.csv",
        validation="build/siteyears_2013.nc",
    resources:
        mem_mb=3000, runtime="10m",
    script:
        "build_siteyears.py"


rule plot_siteyears_validation:
    input:
        validation="build/siteyears_2013.nc",
        calibration="build/siteyears_calibration.csv",
        config="config.yaml",
    output:
        expand("figures/siteyears_validation.{fmt}", fmt=FORMATS),
    resources:
        mem_mb=1500, runtime="5m",
    script:
        "plot_siteyears_validation.py"
